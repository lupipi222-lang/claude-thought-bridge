# Choose one or both: relay,telegram
BRIDGE_SINKS=relay

# Claude Code transcript location. Adjust the project directory for your machine.
# Windows example: C:/Users/you/.claude/projects/C--Users-you/*.jsonl
# Linux example:   /home/you/.claude/projects/-home-you-project/*.jsonl
CLAUDE_TRANSCRIPT_GLOB=C:/Users/you/.claude/projects/**/*.jsonl
BRIDGE_STATE_DIR=./state
BRIDGE_POLL_SECONDS=1.0
BRIDGE_REDACT=common
AUTO_REPLY_FROM_TRANSCRIPT=false

# Self-hosted relay
# The server stays on loopback; put Nginx/Caddy in front of it for HTTPS.
RELAY_BIND_HOST=127.0.0.1
RELAY_BIND_PORT=8787
RELAY_URL=https://home.example.com
RELAY_EVENT_PATH=/api/events
RELAY_AGENT_TOKEN=replace-with-a-long-random-agent-token
RELAY_USER_TOKEN=replace-with-a-different-long-random-user-token
RELAY_DB=./state/relay.sqlite3
PRESENCE_TTL_SECONDS=20

# Optional Web Push for the self-hosted page
# Generate with: python -m thought_bridge.cli vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Telegram mode
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

# Optional proxy used only by outbound Python requests
HTTPS_PROXY=
HTTP_PROXY=
